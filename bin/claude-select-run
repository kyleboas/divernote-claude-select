#!/usr/bin/env python3
"""divernote-claude-select: run one Claude launch on a claude-select account.

index.mjs starts Divernote's Claude runs through this as
`claude-select-run <real claude> <args...>`. Each run uses the current
claude-select account; when a run hits a usage limit, that
account is put in cooldown until its reset time, the next logged-in account
becomes current, and the interrupted Divernote issue is told to continue.

Accounts, cooldowns and the state lock are claude-select's own
(~/.claude-account-state.json), so claude-select's menu shows the same view.
"""
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import threading
import time
from datetime import datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

HERE = Path(__file__).resolve().parent
LOG = Path(os.environ.get("DIVERNOTE_CLAUDE_SELECT_LOG", HERE.parent / "rotate.log"))
SELECTOR = Path(os.environ.get("CLAUDE_SELECT_PATH", Path.home() / ".local" / "bin" / "claude-select"))
# Cooldown when Claude only warns that a limit is near and gives no reset time.
FALLBACK_COOLDOWN = 60 * 60
CONTINUE_MESSAGE = (
    "Your last turn was cut off by a Claude usage limit, and this issue has moved to another "
    "Claude account. Continue the task you were working on; do not repeat work that is already complete."
)


def log(text):
    try:
        with LOG.open("a") as out:
            out.write(f"{datetime.now().isoformat(timespec='seconds')} {text}\n")
    except OSError:
        pass


def load_selector():
    loader = importlib.machinery.SourceFileLoader("claude_select", str(SELECTOR))
    spec = importlib.util.spec_from_loader("claude_select", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def logged_in(config_dir):
    """An account Claude can run: a refresh token counts, since Claude renews the access token."""
    try:
        oauth = json.loads((Path(config_dir) / ".credentials.json").read_text()).get("claudeAiOauth") or {}
    except (OSError, ValueError, AttributeError):
        return False
    if isinstance(oauth.get("refreshToken"), str) and oauth["refreshToken"].strip():
        return True
    expires = oauth.get("expiresAt")
    if not isinstance(oauth.get("accessToken"), str) or isinstance(expires, bool) or not isinstance(expires, (int, float)):
        return False
    return (expires / 1000 if expires > 100_000_000_000 else expires) > time.time() + 60


def eligible(sel, st, name, config_dir):
    try:
        cooling = float(st["accounts"].get(name, {}).get("cooldown_until", 0) or 0) > time.time()
    except (TypeError, ValueError):
        cooling = False
    return not cooling and logged_in(config_dir)


def choose_account(sel):
    """The current account while it has room, else the next one in order that does."""
    with sel.state_lock():
        st = sel.load_state()
        names = [name for name, _ in sel.accounts]
        current = st.get("divernote_current")
        start = names.index(current) if current in names else 0
        chosen = None
        for offset in range(len(sel.accounts)):
            name, config_dir = sel.accounts[(start + offset) % len(sel.accounts)]
            if eligible(sel, st, name, config_dir):
                chosen = (name, config_dir)
                break
        if chosen is None:
            # Everything is cooling down: use the one that resets first, so the
            # run fails fast with Claude's own message instead of hanging.
            chosen = min(
                [a for a in sel.accounts if logged_in(a[1])] or sel.accounts,
                key=lambda a: float(st["accounts"].get(a[0], {}).get("cooldown_until", 0) or 0),
            )
        name = chosen[0]
        if st.get("divernote_current") != name:
            log(f"switching to {name}")
        st["divernote_current"] = name
        st["accounts"][name]["runs"] = st["accounts"][name].get("runs", 0) + 1
        st["accounts"][name]["last_used"] = time.time()
        sel.save_state(st)
    return chosen


def trust_folder(config_dir, cwd):
    """Divernote trusts the issue folder for its own account; do the same for this one."""
    path = Path(config_dir) / ".claude.json"
    try:
        state = json.loads(path.read_text())
    except FileNotFoundError:
        state = {}
    except (OSError, ValueError):
        return
    if not isinstance(state, dict):
        return
    projects = state.get("projects") if isinstance(state.get("projects"), dict) else {}
    if (projects.get(cwd) or {}).get("hasTrustDialogAccepted") is True:
        return
    projects[cwd] = {**(projects.get(cwd) or {}), "hasTrustDialogAccepted": True}
    state["projects"] = projects
    temporary = path.with_name(f".claude.json.rotate-{os.getpid()}.tmp")
    try:
        temporary.write_text(json.dumps(state, indent=2) + "\n")
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
    except OSError:
        temporary.unlink(missing_ok=True)


def session_id(args):
    for flag in ("--session-id", "--resume"):
        if flag in args and args.index(flag) + 1 < len(args):
            return args[args.index(flag) + 1]
    return None


def transcript_path(config_dir, cwd, sid):
    return Path(config_dir) / "projects" / re.sub(r"[^A-Za-z0-9]", "-", cwd) / f"{sid}.jsonl"


RESET = re.compile(r"resets\s+(?:(?P<month>[A-Z][a-z]{2})\s+(?P<day>\d{1,2})\s+at\s+)?(?P<hour>\d{1,2})(?::(?P<minute>\d{2}))?\s*(?P<ampm>am|pm)\s*\((?P<zone>[^)]+)\)", re.I)


def reset_time(text, seen_at):
    match = RESET.search(text or "")
    if not match:
        return None
    try:
        zone = ZoneInfo(match["zone"])
    except Exception:
        return None
    hour = int(match["hour"]) % 12 + (12 if match["ampm"].lower() == "pm" else 0)
    minute = int(match["minute"] or 0)
    now = datetime.fromtimestamp(seen_at, zone)
    if match["month"]:
        month = datetime.strptime(match["month"], "%b").month
        candidate = now.replace(month=month, day=int(match["day"]), hour=hour, minute=minute, second=0, microsecond=0)
        if candidate < now - timedelta(days=180):
            candidate = candidate.replace(year=candidate.year + 1)
    else:
        candidate = now.replace(hour=hour, minute=minute, second=0, microsecond=0)
        if candidate <= now:
            candidate += timedelta(days=1)
    return candidate.timestamp()


def transcript_size(path):
    try:
        return path.stat().st_size
    except OSError:
        return 0


def limit_in_run(path, offset):
    """(cooldown_until, note, hard) when this run hit a usage limit, else None.

    `hard` is Claude refusing the turn outright; otherwise it only warned and
    the turn ends on its own.

    Only what this run appended counts: every account shares one transcript.
    """
    try:
        with path.open("rb") as transcript:
            transcript.seek(offset)
            lines = transcript.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return None
    found = None
    for line in lines:
        if "limit" not in line:
            continue
        try:
            entry = json.loads(line)
            at = datetime.fromisoformat(entry.get("timestamp", "").replace("Z", "+00:00")).timestamp()
        except (ValueError, AttributeError):
            continue
        content = (entry.get("message") or {}).get("content")
        text = content if isinstance(content, str) else " ".join(
            part.get("text", "") for part in content or [] if isinstance(part, dict))
        if entry.get("isApiErrorMessage") and entry.get("error") == "rate_limit":
            found = (reset_time(text, at) or at + FALLBACK_COOLDOWN, text.strip()[:80], True)
        elif entry.get("isMeta") and text.startswith("[Usage limit reached") and found is None:
            found = (at + FALLBACK_COOLDOWN, "usage limit reached", False)
    return found


def main():
    if len(sys.argv) < 2:
        print("usage: claude-select-run <claude> [args...]", file=sys.stderr)
        return 2
    claude, args = sys.argv[1], sys.argv[2:]
    # Divernote says whether it started this run or the user opened it.
    issue_run = os.environ.pop("DIVERNOTE_LAUNCH_PURPOSE", "") == "issue"
    try:
        sel = load_selector()
    except Exception as error:
        # Without claude-select, behave exactly like claude.
        log(f"claude-select unavailable ({error}); running claude unchanged")
        os.execvp(claude, [claude, *args])
    sel.ensure_shared_resume_history()
    name, config_dir = choose_account(sel)
    cwd = os.getcwd()
    trust_folder(config_dir, cwd)
    env = {**os.environ, "CLAUDE_CONFIG_DIR": config_dir}
    sid = session_id(args)
    transcript = transcript_path(config_dir, cwd, sid) if sid else None
    offset = transcript_size(transcript) if transcript else 0
    child = subprocess.Popen([claude, *args], env=env)
    for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(signum, lambda number, _frame: child.poll() is None and child.send_signal(number))
    # Only Divernote's own issue runs are continued or ended; a terminal the
    # user opened on the session is theirs to drive.
    handled = threading.Event()

    def watch():
        # After a hard limit Claude sits idle and never ends the turn, so
        # Divernote would wait out its two-hour timeout.
        while child.poll() is None and transcript:
            hit = limit_in_run(transcript, offset)
            if hit and hit[2]:
                handled.set()
                on_limit(sel, name, hit, sid, issue_run)
                if issue_run and child.poll() is None:
                    child.terminate()
                    try:
                        child.wait(timeout=10)
                    except subprocess.TimeoutExpired:
                        child.kill()
                return
            time.sleep(2)

    watcher = threading.Thread(target=watch, daemon=True)
    watcher.start()
    code = child.wait()
    watcher.join(timeout=70)
    if not handled.is_set() and transcript:
        hit = limit_in_run(transcript, offset)
        if hit:
            on_limit(sel, name, hit, sid, issue_run)
    return code


def on_limit(sel, name, hit, sid, issue_run):
    """Cool the account down and, when another has room, tell the issue to continue."""
    until, note, _ = hit
    with sel.state_lock():
        st = sel.load_state()
        account = st["accounts"][name]
        account["cooldown_until"] = max(float(account.get("cooldown_until", 0) or 0), until)
        account["reset_note"] = time.strftime("%m-%d %H:%M", time.localtime(until))
        sel.save_state(st)
        another = any(other != name and eligible(sel, st, other, directory) for other, directory in sel.accounts)
    log(f"{name} hit a usage limit ({note}); cooling down until {time.strftime('%m-%d %H:%M', time.localtime(until))}")
    if not another:
        log("no other Claude account has room; the issue stays as it is")
        return
    divernote = shutil.which("divernote")
    if issue_run and divernote:
        try:
            result = subprocess.run(
                [divernote, "pi-message", "--session-id", sid, "--text", CONTINUE_MESSAGE, "--json"],
                capture_output=True, text=True, timeout=60,
            )
            log(f"continue queued for {sid}: {(result.stdout or result.stderr).strip()[:200]}")
        except (OSError, subprocess.TimeoutExpired) as error:
            log(f"could not queue continue for {sid}: {error}")


if __name__ == "__main__":
    raise SystemExit(main())
